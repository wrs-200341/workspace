# Optional real 9001 daily-trend proxy. Keep credentials out of source control.
WORKSPACE_DATA_ROOT=D:\all_projects\workspace\data
DATABASE_URL=file:D:/all_projects/workspace/data/workspace.db
EARNINGS_API_URL=http://127.0.0.1:9001/api/earnings/daily-trend
EARNINGS_API_ALLOWED_HOSTS=127.0.0.1,localhost
# EARNINGS_TREND_TOKEN=replace-locally
NEXT_TELEMETRY_DISABLED=1
# Live AI calls are disabled by default. Set this to true only after configuring
# a provider key and explicitly accepting external network/usage costs.
WORKSPACE_ENABLE_LIVE_PROVIDERS=false
# Production execution concurrency. Waiting tasks do not consume a slot.
WORKSPACE_IMAGE_MODEL_CONCURRENCY=5
WORKSPACE_VIDEO_MODEL_CONCURRENCY=20
WORKSPACE_IMAGE_CONCURRENCY=20
WORKSPACE_VIDEO_CONCURRENCY=50
# 8765 PID/gallery source. Keep local by default; set ALLOW_REMOTE only for a reviewed HTTPS/private endpoint.
WORKSPACE_8765_BASE_URL=http://127.0.0.1:8765
WORKSPACE_8765_TIMEOUT_MS=30000
WORKSPACE_8765_ALLOW_REMOTE=false
# Public HTTPS origin used only for short-lived provider reference bridges.
WORKSPACE_PUBLIC_BASE_URL=
# Provider credentials are intentionally blank. Populate only with newly issued credentials.
GROK_VIDEO_API_KEY=
GROK_VIDEO_BASE_URL=https://snumom.com/v1
YUANAI_GROK_VIDEO_API_KEY=
YUANAI_GROK_VIDEO_BASE_URL=https://yuanai.uk
MGROUTER_API_KEY=
MGROUTER_BASE_URL=https://raw.mgrouter.com/v1
WAN_API_KEY=
WAN_BASE_URL=https://api.manjuai.top
