# Optional real 9001 daily-trend proxy. Keep credentials out of source control.
WORKSPACE_DATA_ROOT=D:\all_projects\workspace\data
DATABASE_URL=file:D:/all_projects/workspace/data/workspace.db
EARNINGS_API_URL=http://127.0.0.1:9001/api/earnings/daily-trend
EARNINGS_API_ALLOWED_HOSTS=127.0.0.1,localhost
# EARNINGS_TREND_TOKEN=replace-locally
NEXT_TELEMETRY_DISABLED=1
# Live AI calls are disabled by default. Set this to true only after configuring
# a provider key and explicitly accepting external network/usage costs.
WORKSPACE_ENABLE_LIVE_PROVIDERS=false
# 8765 PID/gallery source. Keep local by default; set ALLOW_REMOTE only for a reviewed HTTPS/private endpoint.
WORKSPACE_8765_BASE_URL=http://127.0.0.1:8765
WORKSPACE_8765_TIMEOUT_MS=30000
WORKSPACE_8765_ALLOW_REMOTE=false
# Public HTTPS origin used only for short-lived provider reference bridges.
WORKSPACE_PUBLIC_BASE_URL=
# Provider credentials are intentionally blank. Populate only with newly issued credentials.
GROK_VIDEO_API_KEY=
GROK_VIDEO_BASE_URL=https://snumom.com/v1
MGROUTER_API_KEY=
MGROUTER_BASE_URL=https://raw.mgrouter.com/v1
WAN_API_KEY=
WAN_BASE_URL=https://api.manjuai.top
GEMINI_PROMPT_API_KEY=
GEMINI_PROMPT_BASE_URL=https://yuanai.uk
GEMINI_PROMPT_MODEL=gemini-2.5-flash
GPT_PROMPT_API_KEY=
GPT_PROMPT_BASE_URL=https://2999api.com
GPT_PROMPT_MODEL=gpt-5.5
YUANAI_API_KEY=
YUANAI_IMAGE_MODEL=gpt-image-2
YUANAI_IMAGE_BASE_URL=https://yuanai.uk
OAIREGBOX_API_KEY=
OAIREGBOX_BASE_URL=https://newapi-2.oairegbox.cc/v1
OAIREGBOX_MODEL=omni-fast-no-water
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://token.secure-skill.com
MINIMAX_MODEL=minimax-h3
POMOAI_API_KEY=
POMOAI_BASE_URL=https://www.pomoai.ai
POMOAI_MODEL=gemini-3.1-flash-image
# OriginGateway: GPT/Grok use /v1/images/{generations,edits}; Nano uses
# /v1/chat/completions without references and /v1beta ...:generateContent with inlineData references.
ORIGIN_BASE_URL=https://origingateway.com/v1
ORIGIN_GPTIMAGE_API_KEY=
ORIGIN_GROK_API_KEY=
ORIGIN_NANO_API_KEY=
JUNZE_BASE_URL=https://ai.junze.me
JUNZE_API_KEY=
JUNZE_GEMINI_MODEL=gemini-3-pro-image-preview
BIGSNAKE_BASE_URL=https://api.bigsnake.xyz/v1
BIGSNAKE_API_KEY=
BIGSNAKE_MODEL=gpt-5.5
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=
