{
  "name": "workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "node scripts/safe-next-build.mjs",
    "start": "node scripts/start-production.mjs",
    "start:deploy": "node scripts/start-production.mjs --restart-worker",
    "worker": "node scripts/provider-worker-supervisor.mjs",
    "worker:restart": "node scripts/start-production.mjs --restart-worker --no-web",
    "worker:once": "node --import tsx scripts/provider-worker.ts --once",
    "tasks:migrate": "node --import tsx scripts/migrate-provider-tasks.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
